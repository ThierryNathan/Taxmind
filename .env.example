# Variaveis de BACKEND: Edge Functions, n8n e scripts operacionais.
# Contem segredos — nunca colar este conjunto em painel de projeto frontend.
# As variaveis do frontend de onboarding ficam em apps/onboarding/.env.example.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# O runtime das Edge Functions injeta SUPABASE_SERVICE_ROLE_KEY automaticamente
# no formato novo (sb_secret_...), enquanto o restante do projeto — secrets do
# Supabase e variaveis do n8n — ainda usa o formato JWT antigo (eyJ...).
# A generate-dossier compara bytes exatos contra o token que o chamador envia,
# entao esta variavel isolada guarda a versao sb_secret_ so para esse fim
# (consumida pelo node "Edge - Gerar Dossie" no n8n).
# Nao troque a SUPABASE_SERVICE_ROLE_KEY global: ela continua correta nos
# demais usos.
SUPABASE_SECRET_KEY_SB_FORMAT=sb_secret_replace_me

GEMINI_API_KEY=replace_me

WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_APP_SECRET=replace_me

ONBOARDING_BASE_URL=http://localhost:5173/onboarding
SUPABASE_AUTH_REDIRECT_TO=http://localhost:5173/auth/callback
TAXMIND_BOOTSTRAP_SECRET=replace_me_with_32_plus_random_chars
CPF_HASH_PEPPER=replace_me_with_another_32_plus_random_chars

# Roteamento por tipo de mensagem na whatsapp-webhook:
# imagem/documento -> workflow de OCR e classificacao fiscal
# texto            -> workflow de consulta, dossie e registro por texto
# Os paths abaixo correspondem ao campo "path" do node Webhook de cada JSON
# em n8n/workflows/.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/receipt-ocr-classification
N8N_TEXT_WEBHOOK_URL=http://localhost:5678/webhook/consulta-dossie
N8N_HOST=localhost
N8N_PORT=5678

# Bucket privado onde a generate-dossier grava os PDFs (criado sob demanda).
DOSSIE_BUCKET=dossies

# Lido pelo workflow consulta-e-dossie para reencaminhar registro de despesa
# por texto ao workflow de recibo. Configurar no ambiente do n8n, nao no
# Supabase secrets.
RECEIPT_WORKFLOW_WEBHOOK_URL=http://localhost:5678/webhook/receipt-ocr-classification

# --- Fase 10: Open Finance via Pluggy -------------------------------------

# Credenciais da aplicacao no painel do Pluggy. Backend apenas: o navegador
# nunca ve estes valores, ele recebe so o Connect Token de curta duracao
# emitido pela Edge Function pluggy-connect-token.
PLUGGY_CLIENT_ID=replace_me
PLUGGY_CLIENT_SECRET=replace_me

# Segredo proprio para autenticar os webhooks que o Pluggy manda para a
# pluggy-webhook. O Pluggy permite cadastrar headers customizados no webhook
# (campo `headers`); cadastre la o header x-taxmind-webhook-secret com este
# mesmo valor. Se ficar vazio, a function aceita o webhook com um aviso no log
# (todo dado gravado vem de consulta autenticada nossa a API do Pluggy, nunca
# do corpo do webhook), mas o correto e configurar.
PLUGGY_WEBHOOK_SECRET=replace_me

# Terceiro webhook do n8n, separado dos outros dois de proposito. O workflow
# consulta-e-dossie resolve usuario_id por session_id de sessoes_whatsapp e le
# normalized.text_body — uma transacao bancaria nao tem nem sessao de WhatsApp
# nem texto, entao reaproveitar N8N_TEXT_WEBHOOK_URL quebraria o node
# "Montar Contexto". O workflow consumidor ainda nao existe (ver README de
# n8n/workflows/).
N8N_OPENFINANCE_WEBHOOK_URL=http://localhost:5678/webhook/open-finance-transacoes
