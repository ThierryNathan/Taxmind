      "id": "7691e7f6-d8fe-4fcf-a9eb-9ba94c5f3319",
      "name": "Supabase - RPC Resumo Fiscal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        160
      ],
