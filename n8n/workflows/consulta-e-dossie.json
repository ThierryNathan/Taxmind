    {
      "parameters": {
        "jsCode": "const ctx = $('Montar Contexto').first().json;\nconst linhas = $input.all().map((i) => i.json);\n\nconst emojiPorCategoria = {\n  SAUDE: \"\\u{1F3E5}\",\n  EDUCACAO: \"\\u{1F393}\",\n  ALIMENTACAO: \"\\u{1F37D}\\u{FE0F}\",\n  TRANSPORTE: \"\\u{1F697}\",\n  MORADIA: \"\\u{1F3E0}\",\n  ESCRITORIO: \"\\u{1F5C2}\\u{FE0F}\",\n  EQUIPAMENTOS: \"\\u{1F5A5}\\u{FE0F}\",\n  SOFTWARE: \"\\u{1F4BE}\",\n  INTERNET_TELEFONIA: \"\\u{1F4F6}\",\n  SERVICOS_PROFISSIONAIS: \"\\u{1F4BC}\",\n  IMPOSTOS_TAXAS: \"\\u{1F9FE}\",\n  OUTROS: \"\\u{1F4CC}\",\n};\n\nconst brl = (v) =>\n  Number(v || 0).toLocaleString(\"pt-BR\", { style: \"currency\", currency: \"BRL\" });\n\nconst validas = linhas.filter((l) => l && l.categoria);\n\nif (validas.length === 0) {\n  return {\n    json: {\n      ...ctx,\n      mensagem:\n        \"Voce ainda nao tem despesas registradas. Manda a foto de um cupom ou descreve a despesa por texto que eu registro pra voce.\",\n    },\n  };\n}\n\nlet totalGeral = 0;\nlet totalDedutivel = 0;\nlet totalPendente = 0;\n\nconst blocos = validas.map((l) => {\n  totalGeral += Number(l.total || 0);\n  totalDedutivel += Number(l.total_dedutivel || 0);\n  totalPendente += Number(l.pendente_revisao || 0);\n\n  const emoji = emojiPorCategoria[l.categoria] || emojiPorCategoria.OUTROS;\n  const nome =\n    l.categoria.charAt(0) + l.categoria.slice(1).toLowerCase().split(\"_\").join(\" \");\n  return emoji + \" \" + nome + \": \" + brl(l.total) + \" (\" + l.quantidade + \")\";\n});\n\nconst partes = [\n  \"*Seu resumo fiscal*\",\n  blocos.join(\"\\n\"),\n  \"*Total:* \" + brl(totalGeral),\n  \"*Dedutivel:* \" + brl(totalDedutivel),\n];\n\nif (totalPendente > 0) {\n  partes.push(\n    \"\\u{23F3} \" +\n      totalPendente +\n      (totalPendente === 1 ? \" lancamento aguarda\" : \" lancamentos aguardam\") +\n      \" revisao humana.\"\n  );\n}\n\npartes.push(\"Quer o PDF completo? Manda *dossie*.\");\n\nreturn { json: { ...ctx, mensagem: partes.join(\"\\n\\n\") } };"
      },
