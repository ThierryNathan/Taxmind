    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body;\nconst normalized = body.normalized || {};\nconst texto = normalized.text_body || \"\";\n\n// Casa palavra-chave sem depender de acento nem de caixa.\nconst alvo = texto\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\")\n  .toLowerCase();\n\nconst contem = (termos) => termos.some((t) => alvo.includes(t));\n\n// Precedencia: o dossie e checado antes do resumo de proposito. \"resumo\" e\n// palavra comum e apareceria em \"manda o resumo em pdf\", onde a intencao real\n// e o arquivo. Os termos de dossie sao mais especificos, entao ganham.\n//\n// Conectar banco vem antes de todos, mas exigindo DOIS eixos na mesma\n// mensagem: um verbo de conexao e um substantivo de conta/banco. Casar so\n// \"conta\" ou so \"banco\" roubaria \"me manda o resumo da minha conta\" e\n// \"quanto rende o CDB do meu banco\". O prefixo \"conect\"/\"vincul\" cobre as\n// conjugacoes (conecta, conectar, vincule) sem depender de adjacencia.\n// A guarda de \"desconect\"/\"desvincul\" existe porque \"conect\" casa dentro de\n// \"desconectar\": desconexao nao esta implementada e cai na IA.\nlet intent = null;\nif (contem([\"desconect\", \"desvincul\"])) {\n  intent = null;\n} else if (\n  contem([\"conect\", \"vincul\", \"sincroniz\", \"open finance\"]) &&\n  contem([\"banco\", \"conta\", \"bancari\", \"cartao\", \"open finance\"])\n) {\n  intent = \"conectar_banco\";\n} else if (contem([\"dossie\", \"relatorio\", \"pdf\", \"exportar\"])) {\n  intent = \"exportar_dossie\";\n} else if (contem([\"resumo\", \"extrato\", \"quanto tenho\"])) {\n  intent = \"consulta_resumo\";\n}\n\nreturn {\n  json: {\n    session_id: body.session_id || null,\n    message_type: normalized.message_type || null,\n    text_body: normalized.text_body || null,\n    wa_id: normalized.wa_id,\n    phone: normalized.phone,\n    profile_name: normalized.profile_name || null,\n    intent,\n  },\n};"
      },
