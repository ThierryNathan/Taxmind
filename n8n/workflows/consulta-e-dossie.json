        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { role: \"user\", parts: [ { text: \"Classifique a mensagem do usuario em exatamente uma destas categorias:\\n\\nregistro_despesa: o usuario esta informando uma despesa que fez.\\nconsulta_resumo: o usuario quer ver o proprio historico ou os totais ja registrados.\\nexportar_dossie: o usuario quer o relatorio ou o PDF das despesas dele.\\nconectar_banco: o usuario quer conectar, vincular ou sincronizar uma conta bancaria, um cartao ou o Open Finance ao TaxMind para importar transacoes automaticamente.\\nfora_do_escopo_financeiro: a mensagem trata de dinheiro, financas, investimento, credito, juros, emprestimo ou planejamento financeiro em geral, mas NAO e uma despesa a registrar nem uma consulta ao historico dele.\\noutro: qualquer coisa que nao se encaixe nas categorias acima.\\n\\nResponda APENAS a categoria, sem explicacao.\\n\\nMensagem: \" + ($json.text_body || \"\") } ] } ], generationConfig: { temperature: 0, maxOutputTokens: 512, thinkingConfig: { thinkingLevel: \"low\" } } }) }}",
        "options": {}
      },
      "id": "05d3285b-ebcb-47f2-98da-6cc4d73c5f10",
      "name": "Gemini - Classificar Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1520,
        420
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Montar Contexto').item.json;\nconst resposta = $input.item.json;\n\nconst bruto = ((((resposta || {}).candidates || [])[0] || {}).content?.parts?.[0]?.text || \"\")\n  .toLowerCase()\n  .replace(/[^a-z_]/g, \"\");\n\n// \"outro\" fica por ultimo de proposito: e o fallback, e find() retorna o\n// primeiro match. As categorias especificas precisam ser testadas antes.\nconst validos = [\n  \"registro_despesa\",\n  \"consulta_resumo\",\n  \"exportar_dossie\",\n  \"conectar_banco\",\n  \"fora_do_escopo_financeiro\",\n  \"outro\",\n];\n\n// Gemini 3 Flash nao permite desligar thinking (so thinkingLevel minimal/low/\n// medium/high). Se o thinking consumir o maxOutputTokens, o texto volta vazio.\n// Cair em \"outro\" mantem o fluxo vivo com a mensagem de ajuda, em vez de\n// derrubar a execucao com intent indefinido.\nconst intent = validos.find((v) => bruto.includes(v)) || \"outro\";\n\nreturn { json: { ...ctx, intent } };"
      },
