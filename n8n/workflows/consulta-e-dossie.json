    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Preparar Contexto').item.json;\nconst resposta = $input.item.json;\n\n// O PostgREST devolve array; o node HTTP pode ja ter desmembrado em item unico.\nconst linha = Array.isArray(resposta) ? resposta[0] : resposta;\nconst usuarioId = linha && linha.usuario_id ? linha.usuario_id : null;\n\n// Mesma postura do outro workflow: falhar explicitamente e melhor do que gravar\n// ou responder com vinculo errado quando o onboarding nao foi concluido.\nif (!usuarioId) {\n  throw new Error(\n    \"Sessao \" + ctx.session_id + \" sem usuario_id vinculado: onboarding nao concluido.\"\n  );\n}\n\nreturn { json: { ...ctx, usuario_id: usuarioId } };"
      },
